<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pure #000000 from the very first frame: windowBackground paints black
         before Compose attaches, so cold start and activity transitions never
         flash a lighter surface. -->
    <style name="Theme.PivotLauncher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
